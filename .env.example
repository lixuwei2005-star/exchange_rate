# =============================================================================
# rate.005917.xyz — environment variables
#
# Copy to .env and edit. DO NOT commit .env.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Environment mode (controls cookie Secure flag, CORS allowlist, debug behavior)
#   dev  -> cookies are not Secure (so localhost http works), CORS allows :3000
#   prod -> cookies Secure=True, CORS restricted to public origin
# -----------------------------------------------------------------------------
ENV=dev

# -----------------------------------------------------------------------------
# CORS allowed origins (comma-separated; no spaces)
# Dev:  http://localhost:3000
# Prod: https://rate.005917.xyz
# -----------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Database
# Inside docker: file lives in /data which is mounted as a named volume.
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:////data/rate.db

# -----------------------------------------------------------------------------
# Secrets
#
# FERNET_KEY: used to encrypt sensitive settings.value rows (api keys etc).
# The value below is a VALID placeholder so make dev works out of the box.
# REGENERATE before deploy:  make fernet-key
# -----------------------------------------------------------------------------
FERNET_KEY=jXV6ArgMcNyfMYx2bl6w2BQZtNsraEP2W0hs0HAVB6I=

# JWT signing secret for admin sessions. CHANGE before deploy.
JWT_SECRET=change-me-before-deploy-this-is-not-secure

# JWT cookie lifetime (days)
JWT_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Admin user seed
# On first boot, scripts/seed.py creates an admin with these credentials.
# After first login, remove ADMIN_PASSWORD from .env (the bcrypt hash is in DB).
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Frontend → backend wiring
#
# BACKEND_URL_INTERNAL: used by Next.js Server Components running inside the
#                       docker network. Reaches the backend container directly.
# NEXT_PUBLIC_BACKEND_URL: exposed to the browser. Must be a URL the user's
#                         browser can resolve.
#
# In dev they differ (container vs host). In prod they collapse behind Nginx
# (set both to https://rate.005917.xyz/api or similar).
# -----------------------------------------------------------------------------
BACKEND_URL_INTERNAL=http://backend:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Disable Next.js telemetry (also avoids a known Windows EXDEV bug on `next build`).
NEXT_TELEMETRY_DISABLED=1

# -----------------------------------------------------------------------------
# Host-side port mapping (only in prod compose; ignored in dev).
# Leave commented to use defaults 8000 / 3000. Set explicit values if those
# ports are taken on the host (e.g. by other docker apps on a shared server).
# Nginx reverse-proxy config must then point to these same ports.
# -----------------------------------------------------------------------------
# BACKEND_HOST_PORT=8765
# FRONTEND_HOST_PORT=3300
